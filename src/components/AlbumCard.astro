---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatDate, isoDate } from "../lib/data";

interface Props { entry: CollectionEntry<"galerie"> }
const { entry } = Astro.props;
const { title, datum, fotky } = entry.data;
const n = fotky.length;
const label = n === 1 ? "fotka" : n < 5 ? "fotky" : "fotek";
---
<article class="album reveal">
  <Image class="album__img" src={fotky[0]} alt="" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" />
  <div class="album__body">
    <h3><a class="card__link" href={`/galerie/${entry.id}/`}>{title}</a></h3>
    <p><time datetime={isoDate(datum)}>{formatDate(datum)}</time> · {n} {label}</p>
  </div>
</article>
