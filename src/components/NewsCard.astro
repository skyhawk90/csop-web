---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import fallback from "../assets/img/obnova-lesu.jpg";
import { formatDate, isoDate } from "../lib/data";

interface Props { entry: CollectionEntry<"aktuality"> }
const { entry } = Astro.props;
const { title, datum, perex, obrazek, obrazek_popis } = entry.data;
---
<article class="card reveal">
  <Image class="card__img" src={obrazek ?? fallback} alt={obrazek ? (obrazek_popis ?? "") : ""} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" />
  <div class="card__body">
    <time class="card__date" datetime={isoDate(datum)}>{formatDate(datum)}</time>
    <h3><a class="card__link" href={`/aktuality/${entry.id}/`}>{title}</a></h3>
    <p>{perex}</p>
  </div>
</article>
