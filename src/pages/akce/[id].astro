---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Icon from "../../components/Icon.astro";
import { formatRange, weekday, todayIso, isoDate } from "../../lib/data";

export async function getStaticPaths() {
  const all = await getCollection("akce", (e) => import.meta.env.DEV || !e.data.koncept);
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, datum, datum_do, cas, misto, perex, obrazek, odkaz } = entry.data;
const { Content } = await render(entry);
const past = isoDate(datum_do ?? datum) < todayIso();
---
<Base title={title} description={perex} image={obrazek}>
  <PageHead eyebrow={past ? "Proběhlá akce" : "Akce"} title={title} back={{ href: "/akce/", label: "Všechny akce" }}>
    <dl class="facts-row">
      <div><dt><Icon name="calendar-blank" />Kdy</dt><dd>{!datum_do && `${weekday(datum)}, `}{formatRange(datum, datum_do)}</dd></div>
      {cas && <div><dt><Icon name="clock" />Začátek</dt><dd>{cas}</dd></div>}
      {misto && <div><dt><Icon name="map-pin" />Kde</dt><dd><a href={`https://mapy.cz/zakladni?q=${encodeURIComponent(misto)}`} target="_blank" rel="noopener">{misto}</a></dd></div>}
    </dl>
  </PageHead>
  <article class="wrap page-body article">
    {obrazek && <Image class="article__img" src={obrazek} alt="" widths={[640, 1200]} sizes="(max-width: 860px) 100vw, 760px" />}
    <p class="article__perex">{perex}</p>
    <div class="prose"><Content /></div>
    {odkaz && <a class="link-arrow" href={odkaz} target="_blank" rel="noopener">Více informací <Icon name="arrow-up-right" /></a>}
  </article>
</Base>
